{
  "expo": {
    "name": "SMS Forwarder",
    "slug": "sms-forwarder",
    "version": "1.0.0",

    "orientation": "portrait",
    "icon": "./assets/images/smslogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/smslogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smsforwarder.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.smsforwarder.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/smslogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "blockedPermissions": [],
      "playStoreUrl": ""
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "permissions": [
              "android.permission.RECEIVE_SMS",
              "android.permission.READ_SMS",
              "android.permission.FOREGROUND_SERVICE",
              "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
            ],
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a37ba749-55fd-47ad-94f0-c5d1ba05af21"
      },
      "router": {}
    }
  }
}
